# Copy to .env and add newly rotated credentials. The populated .env is ignored by Git.
# Key pools accept a JSON array, comma-separated values, or semicolon-separated values.

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

PROVIDER_PRIORITY=openrouter,gemini,openai,deepseek

# Optional for speaker diarization. Accept the model terms before use.
PYANNOTE_TOKEN=

# Optional Lip-Sync Engine Commands ({video}, {audio}, {output} will be formatted)
# Tier 1 (Preview): MuseTalk fast preview command
# AIDUB_MUSETALK_COMMAND=python -m musetalk.inference --video {video} --audio {audio} --output {output}
# Tier 2 (Cinema): LatentSync cinema quality command
# AIDUB_LATENTSYNC_COMMAND=python LatentSync/inference.py --video {video} --audio {audio} --output {output}
